# 이 파일을 ".env"로 복사한 뒤 실제 값을 채우세요. (.env는 Git에 올라가지 않아요)
PORT=3000
NODE_ENV=production

# ── Supabase (Settings > API Keys) ─────────────────────────────
# 프로젝트 기본 URL. /rest/v1은 붙이지 않아요.
SUPABASE_URL=https://iomzrtqxjiewqvbklrxy.supabase.co
# 서버용 Secret key(sb_secret_...). 클라이언트(VITE_*)에는 절대 넣지 않아요.
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_real_key

# ── 로그인 토큰 서명 비밀키 (32자 이상의 임의 문자열) ──────────
# 만드는 법:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=sb_secret_replace_with_your_real_key

# ── 총괄 운영자 (서버가 시작할 때 이 계정을 만들거나 맞춰요) ───
SUPER_ADMIN_EMAIL=khs9523007@ajou.ac.kr
SUPER_ADMIN_PASSWORD=khs202522272
SUPER_ADMIN_NICKNAME=세계수

# ── 브라우저에서 접속을 허용할 주소 (쉼표로 구분) ──────────────
# 로컬 개발: http://localhost:5173,http://momentree.localhost:5173
# 배포 후에는 Vercel 주소를 추가하세요. 예) https://momentree.vercel.app
CORS_ORIGINS=http://localhost:5173,http://momentree.localhost:5173

# ── 이메일 인증번호 발송 (Brevo 무료 플랜) ─────────────────────
# 비워 두면 메일을 보내지 못해요. 개발 중에는 아래 ALLOW_DEMO_CODE=true로 화면에 번호를 보여줄 수 있어요.
BREVO_API_KEY=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=모먼트리
# 개발용: 메일 서비스가 없을 때 인증번호를 응답에 담아 화면에 보여줘요. 배포 환경에서는 false(또는 생략)!
ALLOW_DEMO_CODE=true

# Used only by npm run auth:setup-naver. Do not put these in VITE_ variables.
NAVER_CLIENT_ID=9C7lgtzSwkQIioMGZWlk
NAVER_CLIENT_SECRET=sb_secret_replace_with_your_real_key
